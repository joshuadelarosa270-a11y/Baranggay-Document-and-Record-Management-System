{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "baranggay-document-and-record-management-system",
  "compatibility_date": "2026-11-27",
  "build": {
    "command": "node scripts/build-cloudflare.cjs"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
